@page
@model MoneyBot.Views.TransactionsModel
@{
    ViewData["Title"] = "Transactions Dashboard";
}

<div class="bank-shell" style="max-width: 960px; margin: 30px auto; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 26px; font-weight: 700; color: #fff; margin: 0 0 6px 0;">Transactions & Dashboard</h1>
            <p style="color: rgba(255,255,255,0.6); margin: 0; font-size: 14px;">Synced transactions directly from PostgreSQL via EF Core.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <a asp-page="/ConnectBank" class="action-btn" style="padding: 10px 18px; background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 14px;">
                + Connect Another Bank
            </a>
            <a asp-page="/Index" class="action-btn" style="padding: 10px 18px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #fff; text-decoration: none; border-radius: 8px; font-size: 14px;">
                Back to Assistant
            </a>
        </div>
    </div>

    <!-- Summary metrics -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 28px;">
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px;">
            <span style="font-size: 13px; color: rgba(255,255,255,0.6);">Total Outflow</span>
            <div style="font-size: 22px; font-weight: 600; color: #fff; margin-top: 6px;" class="tabular-nums">R @Model.TotalSpent.ToString("N2")</div>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px;">
            <span style="font-size: 13px; color: rgba(255,255,255,0.6);">Total Inflow</span>
            <div style="font-size: 22px; font-weight: 600; color: #34d399; margin-top: 6px;" class="tabular-nums">R @Model.TotalIncome.ToString("N2")</div>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px;">
            <span style="font-size: 13px; color: rgba(255,255,255,0.6);">Plaid Synced Records</span>
            <div style="font-size: 22px; font-weight: 600; color: #60a5fa; margin-top: 6px;" class="tabular-nums">@Model.PlaidCount items</div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; overflow: hidden;">
        @if (Model.Transactions.Count == 0)
        {
            <div style="padding: 48px; text-align: center; color: rgba(255,255,255,0.5);">
                <p style="font-size: 16px; margin-bottom: 12px;">No transactions found in database.</p>
                <p style="font-size: 13px;">Use the <a asp-page="/ConnectBank" style="color: #34d399;">Connect Bank</a> page with Plaid Sandbox (user_good / pass_good) to sync records.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="background: rgba(255, 255, 255, 0.04); border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: rgba(255,255,255,0.6);">
                            <th style="padding: 14px 18px;">Date</th>
                            <th style="padding: 14px 18px;">Merchant / Name</th>
                            <th style="padding: 14px 18px;">Category</th>
                            <th style="padding: 14px 18px;">Source</th>
                            <th style="padding: 14px 18px; text-align: right;">Amount</th>
                            <th style="padding: 14px 18px; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Transactions)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                                <td style="padding: 14px 18px; color: rgba(255,255,255,0.7);" class="tabular-nums">@item.Date.ToString("yyyy-MM-dd")</td>
                                <td style="padding: 14px 18px; font-weight: 500; color: #fff;">@(item.Merchant ?? "Unknown Merchant")</td>
                                <td style="padding: 14px 18px; color: rgba(255,255,255,0.8);">
                                    <span style="background: rgba(255,255,255,0.06); padding: 4px 8px; border-radius: 6px; font-size: 12px;">
                                        @(item.Category ?? "uncategorized")
                                    </span>
                                </td>
                                <td style="padding: 14px 18px; color: rgba(255,255,255,0.6);">
                                    <span style="text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; padding: 2px 6px; border-radius: 4px; background: @(item.Source == "plaid" ? "rgba(96, 165, 250, 0.15); color: #60a5fa;" : "rgba(255,255,255,0.08); color: #ccc;")">
                                        @item.Source
                                    </span>
                                </td>
                                <td style="padding: 14px 18px; text-align: right; font-weight: 600; color: @(item.Amount > 0 ? "#fff" : "#34d399");" class="tabular-nums">
                                    @(item.Amount > 0 ? $"R {item.Amount:N2}" : $"-R {Math.Abs(item.Amount):N2}")
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    @if (item.Pending)
                                    {
                                        <span style="font-size: 11px; color: #fbbf24; background: rgba(251, 191, 36, 0.15); padding: 2px 6px; border-radius: 4px;">Pending</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; color: #34d399; background: rgba(52, 211, 153, 0.15); padding: 2px 6px; border-radius: 4px;">Posted</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
