@page
@model MoneyBot.Views.IndexModel
@{
    ViewData["Title"] = "Financial Assistant";
}

<div class="bank-shell" id="appShell">
    <!-- 240px Desktop Banking Sidebar (hidden below 768px) -->
    <aside class="bank-sidebar" aria-label="Banking navigation and balances">
        <div class="brand-row">
            <span class="brand-dot" aria-hidden="true"></span>
            <span class="brand-name">Money assistant</span>
            <span class="brand-badge">Encrypted</span>
        </div>

        <div class="sidebar-scrollable">
            <!-- Total Liquid Balance -->
            <div class="sidebar-summary-card">
                <span class="summary-label">Total Liquid Balance</span>
                <div class="summary-amount tabular-nums" id="totalBalanceDisplay">
                    R @Model.TotalBalance.ToString("N2")
                </div>
                <div class="summary-subtext">
                    <span class="status-positive tabular-nums">+4.2%</span> vs last month
                </div>
            </div>

            <!-- Connected Accounts --> 
            <!-- Note: These are static mockups for demonstration purposes. In a real application, this would be dynamically generated from the user's connected accounts. -->
            <div class="sidebar-section">
                <div class="sidebar-section-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span class="sidebar-section-title" style="margin-bottom: 0;">Connected Accounts</span>
                    <a asp-page="/ConnectBank" class="new-chat-btn" style="text-decoration: none; padding: 2px 7px; font-size: 11px;">
                        + Connect
                    </a>
                </div>
                <div class="accounts-list">
                    @if (Model.ConnectedAccounts.Count == 0)
                    {
                        <div style="font-size: 12px; color: var(--text-tertiary); padding: 8px; text-align: center; border: 1px dashed var(--border-faint); border-radius: 6px;">
                            No bank connected yet.<br />
                            <a asp-page="/ConnectBank" style="color: var(--color-positive); text-decoration: none; font-weight: 500;">Connect with Plaid</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var acc in Model.ConnectedAccounts)
                        {
                            <div class="account-item">
                                <div class="account-item-top">
                                    <span class="account-name">@acc.Name</span>
                                    <span class="account-balance tabular-nums @(acc.IsNegative ? "status-negative" : (acc.IsPositive ? "status-positive" : ""))">
                                        @(acc.RandBalance < 0 ? $"-R {Math.Abs(acc.RandBalance):N2}" : $"R {acc.RandBalance:N2}")
                                    </span>
                                </div>
                                <div class="account-item-bottom">
                                    <span class="account-mask">@acc.Mask</span>
                                    <span class="account-inst">@acc.Institution</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Budget Progress (Rendered immediately, no counters/grow animations) -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">October Budget</div>
                <div class="budget-widget">
                    <div class="budget-widget-numbers">
                        <span class="budget-spent tabular-nums">R 11,420.50</span>
                        <span class="budget-total tabular-nums">/ R 18,000.00</span>
                    </div>
                    <div class="budget-track">
                        <div class="budget-fill" style="width: 63.4%;" role="progressbar" aria-valuenow="63" aria-valuemin="0" aria-valuemax="100" aria-label="Monthly budget consumed"></div>
                    </div>
                    <div class="budget-footer tabular-nums">
                        <span>63.4% consumed</span>
                        <span>18 days remaining</span>
                    </div>
                </div>
            </div>

            <!-- Sessions Navigation -->
            <div class="sidebar-section">
                <div class="sidebar-section-header-row">
                    <span class="sidebar-section-title">Sessions</span>
                    <button type="button" class="new-chat-btn" id="newSessionBtn" title="Start new session">
                        + New
                    </button>
                </div>
                <div class="conv-list" id="conversationList">
                    <button type="button" class="conv-row active" data-conv-id="1">
                        <span class="conv-title">October Spending Review</span>
                        <span class="conv-preview">Groceries, transport, dining totals</span>
                    </button>
                    <button type="button" class="conv-row" data-conv-id="2">
                        <span class="conv-title">Recurring Subscriptions</span>
                        <span class="conv-preview">Rain 5G, Netflix, Spotify</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="sidebar-footer">
            <button type="button" class="sidebar-settings-btn" id="openSettingsBtn" aria-label="Open Settings">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                <span>Settings</span>
            </button>
        </div>
    </aside>

    <!-- Main Content Column -->
    <main class="bank-main">
        <!-- 56px Frosted Header -->
        <header class="bank-header frosted-surface">
            <div class="header-left">
                <button type="button" class="mobile-toggle-btn" id="mobileMenuBtn" aria-label="Toggle Navigation">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-title-box">
                    <div class="bank-title">Money assistant</div>
                    <div class="secure-badge">
                        <span class="dot-secure" aria-hidden="true"></span>
                        <span>Secure banking assistant</span>
                    </div>
                </div>
            </div>

            <div class="header-right" style="display: flex; align-items: center; gap: 8px;">
                <a asp-page="/ConnectBank" class="header-link-btn" style="color: #34d399; font-size: 13px; text-decoration: none; padding: 6px 12px; background: rgba(16, 185, 129, 0.15); border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.3);">
                    Connect Bank
                </a>
                <a asp-page="/Transactions" class="header-link-btn" style="color: rgba(255, 255, 255, 0.85); font-size: 13px; text-decoration: none; padding: 6px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.15);">
                    Transactions
                </a>
                <button type="button" class="header-icon-btn" id="maskBalancesBtn" title="Mask / Reveal Balances" aria-label="Mask or Reveal Balances">
                    <svg id="maskIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
                <button type="button" class="header-icon-btn" id="headerSettingsBtn" title="Preferences" aria-label="Preferences">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </button>
            </div>
        </header>

        <!-- Centered Scrollable Conversation Viewport (672px max-width) -->
        <div class="conversation-view" id="conversationView">
            <div class="conversation-column">
                <!-- Welcome Group (Entrance animated, no individual staggering) -->
                <div class="welcome animate-entrance" id="welcomeSection">
                    <div class="welcome-header">
                        <h1>How can I help with your money?</h1>
                        <p class="welcome-subtext">Calm, real-time banking telemetry & insights across FNB and Capitec</p>
                    </div>

                    <div class="welcome-cards-grid">
                        <div class="financial-card">
                            <span class="card-label">Monthly Outflow</span>
                            <div class="card-figure tabular-nums" id="cardOutflow">R 11,420.50</div>
                            <span class="card-subtext status-positive tabular-nums">-11.3% vs Sep</span>
                        </div>
                        <div class="financial-card">
                            <span class="card-label">Savings Velocity</span>
                            <div class="card-figure status-positive tabular-nums" id="cardSavings">+59.9%</div>
                            <span class="card-subtext tabular-nums">R 17,079.50 retained</span>
                        </div>
                        <div class="financial-card">
                            <span class="card-label">Subscriptions</span>
                            <div class="card-figure tabular-nums" id="cardSubs">5 Active</div>
                            <span class="card-subtext">R 2,646.99/mo</span>
                        </div>
                    </div>

                    <div class="suggestion-grid">
                        <button type="button" class="suggestion-card" data-prompt="Where did my money go this month?">
                            Where did my money go this month?
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Show top merchants">
                            Show top merchants
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Recurring charges">
                            Recurring charges
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="How much have I saved?">
                            How much have I saved?
                        </button>
                    </div>
                </div>

                <!-- Messages Stream -->
                <div class="message-list" id="messageList">
                    <!-- Populated dynamically -->
                </div>

                <!-- Three-Dot Loading Indicator (4px circular dots, pulse opacity 0.25 to 1.0 over 1.2s) -->
                <div class="loading-row animate-entrance" id="loadingRow" style="display: none;" role="status" aria-live="polite">
                    <div class="typing-dots" aria-hidden="true">
                        <span class="pulse-dot"></span>
                        <span class="pulse-dot"></span>
                        <span class="pulse-dot"></span>
                    </div>
                    <span class="loading-status-text" id="loadingStatusText">Money assistant is thinking…</span>
                </div>

                <!-- Error Notification -->
                <div class="error-banner animate-entrance" id="errorBanner" style="display: none;" role="alert">
                    <span id="errorMessage">We couldn't process that request right now.</span>
                    <button type="button" id="retryBtn">Retry</button>
                </div>

                <div id="endScrollAnchor"></div>
            </div>
        </div>

        <!-- Bottom-Anchored Frosted Message Composer -->
        <footer class="composer-glass frosted-surface" aria-label="Message composer">
            <div class="composer-inner">
                <textarea id="composerInput" rows="1" placeholder="Ask about your spending, budget, or transactions" aria-label="Ask about your finances"></textarea>
                <button type="button" class="send-btn" id="sendBtn" disabled aria-label="Send message">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                </button>
            </div>
            <div class="composer-meta">
                <span>End-to-end encrypted · Read-only telemetry</span>
            </div>
        </footer>
    </main>

    <!-- Frosted Settings Panel Dialog (Entrance animated) -->
    <div class="settings-backdrop" id="settingsModal" style="display: none;" role="presentation">
        <div class="settings-panel animate-entrance frosted-surface" role="dialog" aria-modal="true" aria-labelledby="settingsDialogTitle">
            <div class="settings-header">
                <div class="settings-title-row">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <h2 id="settingsDialogTitle">Interface & Motion Settings</h2>
                </div>
                <button type="button" class="settings-close-btn" id="closeSettingsBtn" aria-label="Close Settings">✕</button>
            </div>
            <div class="settings-body">
                <div class="settings-field">
                    <label for="reducedMotionSelect">Reduce Motion Preference</label>
                    <p class="settings-hint">Disables entrance animations, loading pulse cycles, and smooth scrolling.</p>
                    <select id="reducedMotionSelect" class="settings-select">
                        <option value="system">System Default</option>
                        <option value="on">Reduce motion (On)</option>
                        <option value="off">Standard motion (Off)</option>
                    </select>
                </div>
                <div class="settings-field">
                    <label class="toggle-label">
                        <span>Mask Account Balances</span>
                        <input type="checkbox" id="maskBalancesCheckbox" />
                    </label>
                    <p class="settings-hint">Obfuscates financial balances across sidebar and overview.</p>
                </div>
            </div>
            <div class="settings-footer">
                <button type="button" class="settings-done-btn" id="saveSettingsBtn">Done</button>
            </div>
        </div>
    </div>
</div>
