@page
@model MoneyBot.Views.IndexModel
@{
    ViewData["Title"] = "Financial Assistant";
}

<div class="bank-shell" id="appShell">
    <!-- Desktop Banking Sidebar -->
    <aside class="bank-sidebar" aria-label="Banking navigation and balances">
        <div class="brand-row">
            <span class="brand-dot" aria-hidden="true"></span>
            <span class="brand-name">Money assistant</span>
            <span class="brand-badge">Encrypted</span>
        </div>

        <div class="sidebar-scrollable">
            <!-- Total Liquid Balance (Dynamic) -->
            <div class="sidebar-summary-card">
                <span class="summary-label">Total Balance</span>
                <div class="summary-amount tabular-nums" id="totalBalanceDisplay">
                    R @Model.TotalBalance.ToString("N2")
                </div>
            </div>

            <!-- Connected Accounts (Starts Blank Until Bank Linked) -->
            <div class="sidebar-section">
                <div class="sidebar-section-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span class="sidebar-section-title" style="margin-bottom: 0;">Connected Accounts</span>
                    <a asp-page="/ConnectBank" class="new-chat-btn" style="text-decoration: none; padding: 2px 7px; font-size: 11px;">
                        + Connect
                    </a>
                </div>
                <div class="accounts-list">
                    @if (Model.ConnectedAccounts.Count == 0)
                    {
                        <div style="font-size: 12px; color: rgba(255,255,255,0.5); padding: 12px; text-align: center; border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px;">
                            No bank connected yet.<br />
                            <a asp-page="/ConnectBank" style="color: #34d399; text-decoration: none; font-weight: 500; display: inline-block; margin-top: 4px;">Connect with Plaid &rarr;</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var acc in Model.ConnectedAccounts)
                        {
                            <div class="account-item">
                                <div class="account-item-top">
                                    <span class="account-name">@acc.Name</span>
                                    <span class="account-balance tabular-nums @(acc.IsNegative ? "status-negative" : (acc.IsPositive ? "status-positive" : ""))">
                                        @(acc.RandBalance < 0 ? $"-R {Math.Abs(acc.RandBalance):N2}" : $"R {acc.RandBalance:N2}")
                                    </span>
                                </div>
                                <div class="account-item-bottom">
                                    <span class="account-mask">@acc.Mask</span>
                                    <span class="account-inst">@acc.Institution</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Monthly Budget -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">Monthly Budget</div>
                <div class="budget-widget">
                    <div class="budget-widget-numbers">
                        <span class="budget-spent tabular-nums">R @Model.MonthlyOutflow.ToString("N2")</span>
                        <span class="budget-total tabular-nums">/ R 18,000.00</span>
                    </div>
                    <div class="budget-track">
                        @{
                            var budgetLimit = 18000.00m;
                            var pct = budgetLimit > 0 ? Math.Min(100m, (Model.MonthlyOutflow / budgetLimit) * 100m) : 0m;
                            var daysLeft = Math.Max(0, DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month) - DateTime.UtcNow.Day);
                        }
                        <div class="budget-fill" style="width: @pct.ToString("0.#")%;" role="progressbar" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100" aria-label="Monthly budget consumed"></div>
                    </div>
                    <div class="budget-footer tabular-nums">
                        <span>@pct.ToString("0.#")% consumed</span>
                        <span>@daysLeft days remaining</span>
                    </div>
                </div>
            </div>

            <!-- Sessions Navigation (Dynamic LocalStorage Session Switching) -->
            <div class="sidebar-section">
                <div class="sidebar-section-header-row" style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="sidebar-section-title">Sessions</span>
                    <button type="button" class="new-chat-btn" id="newSessionBtn" title="Start new session">
                        + New
                    </button>
                </div>
                <div class="conv-list" id="conversationList">
                    <!-- Populated dynamically by assistant.js -->
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Column -->
    <main class="bank-main">
        <header class="bank-header frosted-surface">
            <div class="header-left">
                <button type="button" class="mobile-toggle-btn" id="mobileMenuBtn" aria-label="Toggle Navigation">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                <div class="header-title-box">
                    <div class="bank-title">Money assistant</div>
                    <div class="secure-badge">
                        <span class="dot-secure" aria-hidden="true"></span>
                        <span>Direct Database Telemetry</span>
                    </div>
                </div>
            </div>

            <div class="header-right" style="display: flex; align-items: center; gap: 8px;">
                <a asp-page="/ConnectBank" class="header-link-btn" style="color: #34d399; font-size: 13px; text-decoration: none; padding: 6px 12px; background: rgba(16, 185, 129, 0.15); border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.3);">
                    Connect Bank
                </a>
                <a asp-page="/ImportCsv" class="header-link-btn" style="color: #60a5fa; font-size: 13px; text-decoration: none; padding: 6px 12px; background: rgba(96, 165, 250, 0.15); border-radius: 6px; border: 1px solid rgba(96, 165, 250, 0.3);">
                    Import CSV
                </a>
                <a asp-page="/Transactions" class="header-link-btn" style="color: rgba(255, 255, 255, 0.85); font-size: 13px; text-decoration: none; padding: 6px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.15);">
                    Transactions
                </a>
                <button type="button" class="header-icon-btn" id="maskBalancesBtn" title="Mask / Reveal Balances" aria-label="Mask or Reveal Balances">
                    <svg id="maskIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>
        </header>

        <div class="conversation-view" id="conversationView">
            <div class="conversation-column">
                <div class="welcome animate-entrance" id="welcomeSection">
                    <div class="welcome-header">
                        <h1>How can I help with your money?</h1>
                        <p class="welcome-subtext">Real-time banking telemetry & database-driven spending analysis</p>
                    </div>

                    <div class="welcome-cards-grid">
                        <div class="financial-card">
                            <span class="card-label">Monthly Outflow</span>
                            <div class="card-figure tabular-nums" id="cardOutflow">R @Model.MonthlyOutflow.ToString("N2")</div>
                            <span class="card-subtext @(Model.OutflowChangePercent <= 0 ? "status-positive" : "status-negative") tabular-nums">
                                @(Model.OutflowChangePercent <= 0 ? $"{Model.OutflowChangePercent:0.#}%" : $"+{Model.OutflowChangePercent:0.#}%") vs last month
                            </span>
                        </div>
                        <div class="financial-card">
                            <span class="card-label">Savings Velocity</span>
                            <div class="card-figure status-positive tabular-nums" id="cardSavings">+@Model.SavingsRate.ToString("0.#")%</div>
                            <span class="card-subtext tabular-nums">R @Model.MonthlyInflow.ToString("N2") inflow</span>
                        </div>
                        <div class="financial-card">
                            <span class="card-label">Active Subscriptions</span>
                            <div class="card-figure tabular-nums" id="cardSubs">@Model.ActiveSubscriptionsCount Active</div>
                            <span class="card-subtext tabular-nums">R @Model.SubscriptionsMonthlyTotal.ToString("N2")/mo</span>
                        </div>
                    </div>

                    <div class="suggestion-grid">
                        <button type="button" class="suggestion-card" data-prompt="Where did my money go this month?">
                            Where did my money go this month?
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Show top merchants">
                            Show top merchants
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Recurring charges">
                            Recurring charges
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="How much have I saved?">
                            How much have I saved?
                        </button>
                    </div>
                </div>

                <div class="message-list" id="messageList"></div>

                <div class="loading-row animate-entrance" id="loadingRow" style="display: none;" role="status">
                    <div class="typing-dots" aria-hidden="true">
                        <span class="pulse-dot"></span>
                        <span class="pulse-dot"></span>
                        <span class="pulse-dot"></span>
                    </div>
                    <span class="loading-status-text">Analyzing database records…</span>
                </div>

                <div class="error-banner animate-entrance" id="errorBanner" style="display: none;" role="alert">
                    <span id="errorMessage">We couldn't process that request right now.</span>
                    <button type="button" id="retryBtn">Retry</button>
                </div>

                <div id="endScrollAnchor"></div>
            </div>
        </div>

        <footer class="composer-glass frosted-surface">
            <div class="composer-inner">
                <textarea id="composerInput" rows="1" placeholder="Ask about your spending, budget, or transactions"></textarea>
                <button type="button" class="send-btn" id="sendBtn" disabled aria-label="Send message">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                </button>
            </div>
            <div class="composer-meta">
                <span>Direct LINQ database telemetry · Read-only access</span>
            </div>
        </footer>
    </main>
</div>